{
  "name": "@mono-lit/devextreme",
  "version": "0.0.1",
  "description": "DevExtreme data layer (DataSource, stores) re-exported from one place for the @mono-lit packages.",
  "keywords": [
    "devextreme",
    "datasource",
    "odata",
    "mono-lit"
  ],
  "author": "Nemure231",
  "license": "MIT",
  "homepage": "https://github.com/mono-lit/core/tree/main/packages/devextreme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mono-lit/core.git",
    "directory": "packages/devextreme"
  },
  "bugs": {
    "url": "https://github.com/mono-lit/core/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "devextreme": "25.1.6"
  },
  "devDependencies": {
    "taze": "^19.14.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
